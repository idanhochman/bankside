digraph fadd_accumulator_loop {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.5,
         newrank=true, labeljust=l];
  node  [shape=box, fontname="Helvetica", fontsize=10, height=0.3, margin="0.15,0.06"];
  edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7];

  s34  [label="S3/S4 register\n(pcu_datapath/doc)"];
  s45  [label="S4/S5 register\n(pcu_datapath/doc)"];
  sel  [label="write-port select\n(top/doc/hierarchy.md)"];
  wt   [label="grf_b port 2\nwrite-through multiplexer\n(pcu_regfile/doc)"];
  add  [shape=record, label="{{<a>a|<b>b}|fp16_add\n(fp16_add/doc)|{<s>s}}"];
  r    [label="choice of r\n(pcu_datapath/doc)"];

  s45 -> sel    [label="grf_b_wr_*", penwidth=2];
  sel -> wt     [label="write port", penwidth=2];
  wt -> add:a   [label="grf_b_rd_data[2]\n= acc, 256", penwidth=2];
  s34 -> add:b  [label="x, 256"];
  add:s -> r    [label="s (16 lanes)", penwidth=2];
  r -> s45      [label="r, 256", penwidth=2, constraint=false];
}
